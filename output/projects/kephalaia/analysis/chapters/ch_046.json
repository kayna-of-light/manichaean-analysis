        "seam_note": null
      }
    },
    {
      "index": 4,
      "words": 68,
      "text": "[Bef]ore sin had multiplied and had made a kingdom in the flesh, before the acquitted and the condemn[ed] were set apart from each other, the Judge [w]as sent forth and revealed. His throne was created and placed [i]n the living atmosphere, so that he would be a just Judge, so that there the righteous and the sinners would be set apart and tested and separated from each other.",
      "scores": {
        "substrate": 4.41,
        "dialogue_frame": 0.0,
        "editorial_bridge": 0.0,
        "institutional": 0.0,
        "exhortation": 0.0
      },
      "seam": {
